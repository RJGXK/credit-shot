# ---- Python 缓存 / 虚拟环境 ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- 打包产物（体积大，由 tools/build_exe.py + tools/build_installer.py 重新生成）----
# build/ 与 dist/ 都是构建输出目录，**不入库**；
# 最终安装包归档在 release/ 下（走 Git LFS），源码树里不留 dist/
build/
dist/

# release/ 只放对外发布的成品：安装包入库（Git LFS），其余忽略
release/*
!release/企业信用一键截图工具_安装包.exe

# ---- 运行时产物（截图、探针输出、界面预览）----
probe_out/
sample_output/
web_preview/
截图输出/
output/
*.log

# ---- 凭据与密钥（绝不入库）----
凭据.ini
*.ini
!installer.nsi

# ---- 历史备份（回退用，不入库）----
*.bak
*.orig
*.rej

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
desktop.ini
